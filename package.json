{
  "name": "coinflip",
  "version": "1.0.0",
  "description": "Non-custodial crypto coin-flip gambling game with provably fair randomness",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "verify-db": "tsx scripts/verify-db.ts",
    "check-db": "tsx scripts/verify-db.ts",
    "migrate": "tsx scripts/migrate.ts",
    "indexer": "tsx scripts/event-indexer.ts",
    "indexer:dev": "tsx watch scripts/event-indexer.ts",
    "indexer:prod": "NODE_ENV=production tsx scripts/production-indexer.ts",
    "test": "echo 'Note: Hardhat tests require separate tsconfig. Run: npx hardhat test' && exit 0",
    "test:contracts": "npx hardhat test --config hardhat.config.ts",
    "compile": "npx hardhat compile",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose down",
    "db:logs": "docker-compose logs -f postgres",
    "migrate:local": "tsx scripts/migrate-local.ts",
    "migrate:cloud": "tsx scripts/migrate-cloud.ts",
    "migrations:show": "tsx scripts/show-migrations.ts"
  },
  "keywords": [
    "web3",
    "crypto",
    "gambling",
    "coinflip",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@dicebear/collection": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "@radix-ui/themes": "^3.2.1",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@react-three/cannon": "^6.6.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.12",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "next": "^16.1.0",
    "react": "^19.2.3",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "typescript": "^5.9.3",
    "viem": "^2.43.2",
    "wagmi": "^2.19.5",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/chai": "^4.3.20",
    "@types/three": "^0.182.0",
    "autoprefixer": "^10.4.23",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.0",
    "hardhat": "^2.28.0",
    "pg": "^8.16.3",
    "postcss": "^8.4.31",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  }
}
