{
  "name": "coinflip",
  "version": "1.0.0",
  "description": "Non-custodial crypto coin-flip gambling game with provably fair randomness",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "verify-db": "tsx scripts/verify-db.ts",
    "check-db": "tsx scripts/verify-db.ts",
    "migrate": "tsx scripts/show-migrations.ts",
    "indexer": "tsx scripts/event-indexer.ts",
    "indexer:dev": "tsx watch scripts/event-indexer.ts",
    "indexer:prod": "NODE_ENV=production tsx scripts/event-indexer.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:integration": "vitest run tests/integration",
    "test:contracts": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat test",
    "test:contracts:coverage": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat coverage",
    "test:all": "pnpm test && pnpm test:contracts",
    "compile": "npx hardhat compile",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose down",
    "db:logs": "docker-compose logs -f postgres",
    "migrations:show": "tsx scripts/show-migrations.ts",
    "audit:security": "tsx scripts/security-audit.ts",
    "audit:security:save": "tsx scripts/security-audit.ts --save --md",
    "audit:security:json": "tsx scripts/security-audit.ts --json"
  },
  "keywords": [
    "web3",
    "crypto",
    "gambling",
    "coinflip",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@dicebear/collection": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "@radix-ui/themes": "^3.2.1",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@sentry/nextjs": "^10.32.1",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.12",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.0",
    "pino": "^10.1.0",
    "react": "^19.2.3",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.9.3",
    "viem": "^2.43.2",
    "wagmi": "^2.19.5",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/chai": "^4.3.20",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.0.11",
    "hardhat": "^2.28.0",
    "jsdom": "^27.4.0",
    "pg": "^8.16.3",
    "postcss": "^8.4.31",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  }
}
