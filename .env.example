# Public Environment Variables (exposed to browser)

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id_here

# Supabase Configuration (get from https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Smart Contract Addresses
NEXT_PUBLIC_COINFLIP_CONTRACT_ADDRESS_MUMBAI=0x...
NEXT_PUBLIC_COINFLIP_CONTRACT_ADDRESS_POLYGON=0x...

# Blockchain Network Configuration
NEXT_PUBLIC_CHAIN_ID=80001  # 80001 for Mumbai testnet, 137 for Polygon mainnet
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Application Configuration
NEXT_PUBLIC_APP_NAME=CoinFlip
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_TESTNET=true
