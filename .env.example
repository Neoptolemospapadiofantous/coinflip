# ===========================================
# Public Environment Variables
# (exposed to browser via NEXT_PUBLIC_ prefix)
# ===========================================

# WalletConnect Project ID (required)
# Get from: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id_here

# Supabase Configuration (required)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Smart Contract Addresses
# Sepolia Testnet (recommended for testing)
NEXT_PUBLIC_COINFLIP_CONTRACT_ADDRESS_SEPOLIA=0x0D24d83E396c96759294b2b0C5c6C64F7DB189CB

# Polygon Amoy Testnet (Mumbai deprecated April 2024)
NEXT_PUBLIC_COINFLIP_CONTRACT_ADDRESS_AMOY=0xD94991Babc68bA91Ec3B0c4B36fbA6f2d60385ae

# Polygon Mainnet (production)
NEXT_PUBLIC_COINFLIP_CONTRACT_ADDRESS_POLYGON=0x...

# Blockchain Network Configuration
# Chain IDs: 11155111 (Sepolia), 80002 (Amoy), 137 (Polygon Mainnet)
NEXT_PUBLIC_CHAIN_ID=11155111

# Alchemy API Key (optional but recommended for better RPC reliability)
# Get from: https://www.alchemy.com
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Application Configuration
NEXT_PUBLIC_APP_NAME=CoinFlip
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_TESTNET=true

# ===========================================
# Private Server-Side Variables
# (NOT exposed to browser)
# ===========================================

# Supabase Service Role Key (required for production indexer)
# CRITICAL: Use service_role key, NOT anon key
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Wallet Private Key (required for contract deployment ONLY)
# WARNING: Never commit this to git. Keep this secret!
PRIVATE_KEY=21648894b7956dd2a96f1dd217869bf53106a7547905e6e753498d5e3d99a125

# Chainlink VRF Configuration (required for smart contract)
# Get from: https://vrf.chain.link
VRF_SUBSCRIPTION_ID=36534247073274299435646001531445000689090533189514176058290518552839108904477

# RPC URLs (required for deployment and indexer)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_alchemy_key
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_key

# Production Indexer Configuration
NODE_ENV=development
