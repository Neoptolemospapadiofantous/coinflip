# NPM Configuration

# Strict peer dependencies
strict-peer-dependencies=false

# Lockfile settings
lockfile=true

# Security overrides for known non-issues
# These vulnerabilities are in @openzeppelin/contracts-upgradeable (transitive dependency)
# We don't use upgradeable contracts, so these don't affect us
# Monitoring Chainlink for updates

# Auto-install peer dependencies
auto-install-peers=true

# Use exact versions for production builds
save-exact=false

# Prefer offline when possible
prefer-offline=true
