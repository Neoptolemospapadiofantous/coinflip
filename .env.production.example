# ===========================================
# PRODUCTION Environment Variables
# Copy this to .env.production.local
# ===========================================

# ===========================================
# Required: Public Variables (browser-exposed)
# ===========================================

# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Supabase Configuration
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Smart Contract Address (production)
# Deploy with: pnpm hardhat run scripts/deploy.ts --network polygon
NEXT_PUBLIC_COINFLIP_CONTRACT_ADDRESS_POLYGON=

# Blockchain Network (137 = Polygon Mainnet)
NEXT_PUBLIC_CHAIN_ID=137

# Application Configuration
NEXT_PUBLIC_APP_NAME=CoinFlip
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_TESTNET=false

# ===========================================
# Required: Private Server Variables
# ===========================================

# Supabase Service Role Key (for indexer)
# CRITICAL: Never expose this to the client
SUPABASE_SERVICE_ROLE_KEY=

# RPC URL for indexer and backend operations
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Alchemy API Key (for RPC proxy)
ALCHEMY_API_KEY=

# ===========================================
# Optional: Rate Limiting (Upstash Redis)
# ===========================================

# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# Optional: Error Monitoring (Sentry)
# ===========================================

# Get from: https://sentry.io
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ===========================================
# Optional: Analytics
# ===========================================

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=

# ===========================================
# Production Settings
# ===========================================

NODE_ENV=production

# Logging level (error, warn, info, debug)
LOG_LEVEL=warn

# Health check settings
HEALTH_CHECK_TIMEOUT_MS=5000

# ===========================================
# DO NOT INCLUDE IN PRODUCTION:
# - PRIVATE_KEY (use hardware wallet or KMS)
# - VRF_SUBSCRIPTION_ID (only for deployment)
# ===========================================

# Pre-deployment Checklist:
# [ ] All required variables are set
# [ ] Supabase RLS policies verified
# [ ] Contract deployed and verified on Polygonscan
# [ ] VRF subscription funded with LINK
# [ ] Chainlink Automation configured
# [ ] Database migrations applied
# [ ] SSL/TLS certificates configured
# [ ] CDN configured for static assets
# [ ] Rate limiting tested
# [ ] Error monitoring configured
# [ ] Backup strategy documented
